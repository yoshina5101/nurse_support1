# PostgreSQL 接続文字列（docker-compose を使う場合はこのままでOK）
DATABASE_URL="postgresql://nurse:nurse@localhost:5432/nurse_support?schema=public"

# Auth.js のセッション暗号化キー。`openssl rand -base64 32` などで生成して設定
AUTH_SECRET="please-change-this-to-a-random-secret-string"

# Anthropic Claude API キー（未設定の場合はダミー応答にフォールバックします）
ANTHROPIC_API_KEY=""

# 使用する Claude モデル（任意。未設定時は claude-sonnet-4-6）
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Stripe 決済（未設定の場合はダミー決済＝即時アップグレードにフォールバックします）
# 本番では以下を設定してください。
STRIPE_SECRET_KEY=""
# プレミアム月額サブスクの Price ID（Stripeダッシュボードで作成）
STRIPE_PRICE_ID=""
# Webhook 署名シークレット（stripe listen / ダッシュボードで取得）
STRIPE_WEBHOOK_SECRET=""

# メール送信（SMTP）。未設定の場合は、確認/再設定リンクを画面とログに表示する
# 開発モードにフォールバックします。本番では以下を設定してください。
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="no-reply@nurse-career.example"

# メール内リンクに使うアプリのURL（未設定時はリクエストヘッダから推定）
NEXT_PUBLIC_APP_URL=""


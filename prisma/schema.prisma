// 新卒看護師向け 就職支援アプリ — DBスキーマ
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Plan {
  FREE
  PREMIUM
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  name             String
  role             Role       @default(STUDENT)
  plan             Plan       @default(FREE)
  status           UserStatus @default(ACTIVE)
  emailVerified    DateTime?
  stripeCustomerId String?    @unique
  premiumUntil     DateTime?  // 6ヶ月パック等、買い切りプレミアムの有効期限
  organizationId   String?    // 所属組織（学校・病院）。B2B契約のメンバー
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  selfAnalyses SelfAnalysis[]
  resumes      Resume[]
  essays       Essay[]
  messages     ChatMessage[]
  reports      Report[]            @relation("Reporter")
  interviews   InterviewSession[]
  aiUsages     AiUsage[]
  tokens       VerificationToken[]
  applications Application[]
}

// B2B：学校・病院などの組織。所属メンバーに一括でプレミアムを付与できる。
model Organization {
  id           String   @id @default(cuid())
  name         String
  kind         String   @default("学校") // 学校 / 病院 / その他
  seats        Int      @default(0) // 契約シート数（0は無制限）
  premiumUntil DateTime? // 組織契約のプレミアム有効期限（メンバーに適用）
  contactEmail String   @default("")
  note         String   @db.Text @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members User[]
}

// 応募先（病院・施設）の選考ステータス。
enum ApplicationStatus {
  INTERESTED // 気になる
  APPLIED    // 応募済み
  SCREENING  // 書類選考中
  INTERVIEW  // 面接
  OFFER      // 内定
  REJECTED   // 不採用
  DECLINED   // 辞退
}

// 応募先（病院・施設）と選考の進捗管理。
model Application {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalName String // 病院・施設名
  department   String            @default("") // 希望部署・診療科
  status       ApplicationStatus @default(INTERESTED)
  memo         String            @db.Text @default("")
  // 主要な日程（任意）
  visitDate    DateTime? // 見学日
  deadline     DateTime? // 応募締切
  examDate     DateTime? // 試験・面接日
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tasks ApplicationTask[]

  @@index([userId, status])
}

// 応募先ごとのTODO（提出物・準備など）。締切リマインドにも使える。
model ApplicationTask {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  dueDate       DateTime?
  done          Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// メール確認・パスワードリセット用のワンタイムトークン。
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// アプリ設定（key-value）。利用上限や価格を管理画面から変更するために使う。
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// AI機能の日次利用カウント（userId × 日付[JST] で1レコード）。
model AiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // YYYY-MM-DD (JST)
  count  Int    @default(0)

  @@unique([userId, date])
}

// 自己分析：設問への回答（JSON）とAIによる要約
model SelfAnalysis {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Json
  aiSummary String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 履歴書：構造化した内容（JSON）とAI添削
model Resume {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @default("私の履歴書")
  content    Json
  aiFeedback String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 小論文お題マスタ
model EssayTheme {
  id        String   @id @default(cuid())
  title     String
  prompt    String   @db.Text
  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())

  essays Essay[]
}

// 小論文：本文とAI添削・点数
model Essay {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeId    String?
  theme      EssayTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)
  themeText  String      @db.Text
  body       String      @db.Text
  aiFeedback String?     @db.Text
  score      Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model ChatRoom {
  id          String        @id @default(cuid())
  name        String
  description String        @default("")
  isPremium   Boolean       @default(false)
  createdAt   DateTime      @default(now())

  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  reports Report[]
}

// チャットメッセージへの通報
model Report {
  id         String       @id @default(cuid())
  messageId  String
  message    ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String       @db.Text
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
}

// 面接質問マスタ
model InterviewQuestion {
  id        String   @id @default(cuid())
  text      String   @db.Text
  category  String   @default("一般")
  isPremium Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  sessions InterviewSession[]
}

// 面接練習セッション（1問1回答。音声は保存せず文字起こしのみ）
model InterviewSession {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String?
  question   InterviewQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  questionText String           @db.Text
  answer     String             @db.Text
  aiFeedback String?            @db.Text
  score      Int?
  createdAt  DateTime           @default(now())
}

// 有料/無料コンテンツ
model Content {
  id          String    @id @default(cuid())
  title       String
  body        String    @db.Text
  category    String    @default("お役立ち")
  isPremium   Boolean   @default(false)
  publishedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
